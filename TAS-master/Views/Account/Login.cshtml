@using TAS.DTOs;
@using TAS.Resources
@model LoginRequest
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout_Auth.cshtml";
    var returnUrl = ViewBag.ReturnUrl;
}
@section Style {
    <link rel="stylesheet" href="../Contents/css/Account/Account.css">
}
<!-- [ Pre-loader ] End -->
<div class="auth-main">
    <div class="auth-wrapper v1">
        <div class="auth-form">
            <div class="card my-5">
                <div class="card-body card_auth">
                    <div class="text-center logo_auth">
                        <a href="#"><img src="../Logo/LogoBlack.png" alt="img" width="150"></a>
                    </div>
                    <p class="text-muted" id="motivationalQuote"></p>
                    <form id="loginForm" asp-action="Login" asp-controller="Account" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="mb-3">
                            <label class="form-check-label text-dark fw-bold mb-2" for="rememberMe">Username or Email</label>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="text" class="form-control" name="UserName" id="username" value="admin"
                                   placeholder="UserName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-check-label text-dark fw-bold mb-2" for="rememberMe">Password</label>
                            <input type="password" class="form-control" name="Password" id="password" value="123456"
                                   placeholder="Mật khẩu" required>
                        </div>
                        <div class="d-flex mt-1 justify-content-between align-items-center">
                            <div class="form-check">
                                <input class="form-check-input input-primary" type="checkbox" id="rememberMe" checked="">
                                <label class="form-check-label text-muted" for="rememberMe">Remember me?</label>
                            </div>
                            @* <h6 class="text-secondary f-w-400 mb-0">
                                <a href="#">Forgot Password?</a>
                            </h6> *@
                        </div>
                        <div class="d-grid mt-4 btnLogin">
                            <button type="submit" class="btn btn-custom-tas-action" id="btnLogin">@Language.key_login</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    // Array of motivational quotes
    const quotes = [
        "Today is a new day. It's your day. You shape it.<br>Sign in to start managing your projects.",
        "Believe in yourself and all that you are.<br>Let's make today amazing together.",
        "Success is not final, failure is not fatal.<br>It's the courage to continue that counts.",
        "The future depends on what you do today.<br>Sign in and make it happen.",
        "Dream big, work hard, stay focused.<br>Your journey to success starts here.",
        "Every accomplishment starts with the decision to try.<br>Let's begin your productive day.",
        "Your only limit is you.<br>Sign in to unlock your potential.",
        "Great things never come from comfort zones.<br>Ready to make a difference?",
        "The secret of getting ahead is getting started.<br>Welcome back, let's do this!",
        "Be the change you wish to see.<br>Your projects are waiting for you.",
        "Opportunities don't happen, you create them.<br>Let's create something amazing today.",
        "Don't watch the clock, do what it does. Keep going.<br>Time to manage your success.",
        "The only way to do great work is to love what you do.<br>Sign in and love what you create.",
        "Success doesn't just find you. You have to go out and get it.<br>Your dashboard awaits.",
        "Push yourself, because no one else is going to do it for you.<br>Let's start achieving today."
    ];

    // Select random quote on page load
    window.addEventListener('DOMContentLoaded', function() {
        const randomIndex = Math.floor(Math.random() * quotes.length);
        document.getElementById('motivationalQuote').innerHTML = quotes[randomIndex];
    });
</script>